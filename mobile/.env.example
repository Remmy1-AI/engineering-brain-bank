# Brain Bank — Expo public env (safe for the client)
# Prefer EXPO_PUBLIC_* for EAS / local. Cloud Agents may inject BOYE_* instead;
# app.config.js maps BOYE_SUPABASE_URL / BOYE_SUPABASE_ANON_KEY → expo.extra.
#
# NEVER put service_role, access token, DB password, or BulkClix keys here.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
